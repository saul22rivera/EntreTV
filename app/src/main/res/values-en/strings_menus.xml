    <string name="settings_section_playback">Playback</string>
    <string name="settings_live_format">Live channel format</string>
    <string name="settings_live_format_desc">If a channel cuts out or won\'t start, try the other format.</string>
    <string name="settings_live_hls">HLS (.m3u8) · recommended</string>
    <string name="settings_live_ts">MPEG-TS (.ts) · continuous stream</string>
    <string name="settings_decoder">Video decoder</string>
    <string name="settings_decoder_desc">Applies from the next video.</string>
    <string name="settings_decoder_auto">Automatic · the best one on this device (recommended)</string>
    <string name="settings_decoder_hardware">Hardware · lower power use; uses the video chip</string>
    <string name="settings_decoder_software">Software · if the video looks green, black or choppy</string>
    <string name="settings_frame_rate">Match display refresh rate</string>
    <string name="settings_frame_rate_desc">The TV switches to the movie\'s frame rate (24, 25, 50 Hz…) so motion doesn\'t judder. Some TVs go black for a moment when the movie starts and when you leave it.</string>
    <string name="settings_frame_rate_off">Off</string>
    <string name="settings_frame_rate_auto">Automatic · recommended on TV</string>
    <string name="settings_tunneling">Tunneled mode (TV)</string>
    <string name="settings_tunneling_desc">Video and audio go straight to the TV chip: smoother on some devices. If you notice stutter, no sound or lip-sync issues, turn it off. Applies from the next video.</string>
    <string name="settings_skip_intro">Skip intro button</string>
    <string name="settings_skip_intro_desc">Shows up in the first minutes of each episode. If you fast-forward through a series intro yourself, next time it jumps right there.</string>
    <string name="settings_buffer">Startup buffer</string>
    <string name="settings_buffer_desc">Seconds of video loaded before playback starts and after an interruption. Live TV uses half to start faster.</string>
    <string name="settings_buffer_0">0 s · starts instantly, may stutter more</string>
    <string name="settings_buffer_3">3 s · balanced (recommended)</string>
    <string name="settings_buffer_5">5 s · more stable</string>
    <string name="settings_buffer_9">9 s · most stable, slower to start</string>
    <string name="settings_seconds">%1$d s</string>
    <string name="settings_max_buffer">Maximum buffer</string>
    <string name="settings_max_buffer_desc">How much video is downloaded ahead. A bigger buffer copes better with an unstable connection. Movies and series keep twice as much.</string>
    <string name="settings_max_buffer_15">15 s · uses less memory</string>
    <string name="settings_max_buffer_30">30 s · balanced (recommended)</string>
    <string name="settings_max_buffer_60">60 s · unstable connections; live TV runs a bit further behind</string>

