<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EntreTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Pantalla de bienvenida con el logo mientras se abre el catálogo guardado. -->
    <style name="Theme.EntreTV.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#07080C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.EntreTV</item>
    </style>
</resources>
